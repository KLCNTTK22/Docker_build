      ],
      "id": "95cb4de0-2e63-40d6-b141-de9c6fc206a8",
      "name": "Execute Command"
    },
    {
      "parameters": {
        "jsCode": "const stdout = $input.first().json.stdout;\n\nfunction parseTreeOutput(stdout) {\n  const lines = stdout.split(\"\\n\").filter(l => l.trim());\n\n  const root = { name: lines[0], type: \"directory\", children: [] };\n  const stack = [root];\n\n  for (let i = 1; i < lines.length; i++) {\n    const line = lines[i];\n\n    if (line.includes(\"directories\") || line.includes(\"files\")) continue;\n\n    const prefixMatch = line.match(/^[├└─│\\s]+/);\n    const prefixLength = prefixMatch ? prefixMatch[0].length : 0;\n\n    const depth = Math.floor(prefixLength / 4);\n\n    const name = line.replace(/^[├└─│\\s]+/, \"\");\n    \n    const node = {\n      name,\n      type: name.includes(\".\") ? \"file\" : \"directory\",\n      children: []\n    };\n\n    stack.splice(depth);\n\n    stack[stack.length - 1].children.push(node);\n\n    if (node.type === \"directory\") {\n      stack.push(node);\n    }\n  }\n\n  return root;\n}\n\nreturn [{ json: parseTreeOutput(stdout) }];"
      },
      "type": "n8n-nodes-base.code",
