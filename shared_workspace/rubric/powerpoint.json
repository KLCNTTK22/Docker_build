[
  {
    "criteria_name": "Presentation Structure and Slide Count",
    "allocated_points": 2.0,
    "anchor_locator": {
      "type": "global"
    },
    "rules": [
      {
        "description": "Verify the total number of slides in the presentation is 5, fulfilling the 'at least 4 slides' requirement.",
        "action": "VERIFY_COUNT",
        "points": 2.0,
        "element_type": "slide",
        "expected_count": 5
      }
    ]
  },
  {
    "criteria_name": "Slide Master Configuration (Font, Logo, Slide Number)",
    "allocated_points": 3.0,
    "anchor_locator": {
      "type": "slide_master"
    },
    "rules": [
      {
        "description": "Verify title style font in Slide Master is 'Times New Roman'.",
        "action": "VERIFY_PROPERTY",
        "points": 0.5,
        "element_type": "slide_master",
        "property_to_check": "properties.text_styles.titleStyle.font_name",
        "expected_value": "Times New Roman",
        "match_type": "EXACT"
      },
      {
        "description": "Verify body style font in Slide Master is 'Times New Roman'.",
        "action": "VERIFY_PROPERTY",
        "points": 0.5,
        "element_type": "slide_master",
        "property_to_check": "properties.text_styles.bodyStyle.font_name",
        "expected_value": "Times New Roman",
        "match_type": "EXACT"
      },
      {
        "description": "Verify a logo image exists on the Slide Master.",
        "action": "VERIFY_EXISTS",
        "points": 1.0,
        "element_type": "picture"
      },
      {
        "description": "Verify slide number placeholder exists on the Slide Master.",
        "action": "VERIFY_EXISTS",
        "points": 0.5,
        "element_type": "shape",
        "is_placeholder": true,
        "placeholder_type": "sldNum"
      },
      {
        "description": "Verify Slide Number is not present on the Title Slide (Slide 1).",
        "action": "VERIFY_EXISTS",
        "points": 0.5,
        "element_type": "shape",
        "is_placeholder": true,
        "placeholder_type": "sldNum",
        "expected_value": false,
        "anchor_locator": {
          "type": "slide",
          "text_contains": "QUÁ TRÌNH HỌC TẬP VÀ LÀM VIỆC"
        }
      }
    ]
  },
  {
    "criteria_name": "Slide Transitions and Content Animation",
    "allocated_points": 2.0,
    "anchor_locator": {
      "type": "global"
    },
    "rules": [
      {
        "description": "Verify all 5 slides use a 'circle' transition effect.",
        "action": "VERIFY_COUNT",
        "points": 1.0,
        "element_type": "transition",
        "property_to_check": "properties.effect_type",
        "expected_value": "p:circle",
        "match_type": "EXACT",
        "expected_count": 5
      },
      {
        "description": "Verify the content placeholder on the 'BẢN THÂN' slide has 'Float In' animation (presetID 42).",
        "action": "VERIFY_PROPERTY",
        "points": 1.0,
        "element_type": "shape",
        "placeholder_type": "obj",
        "property_to_check": "animations.presetID",
        "expected_value": "42",
        "match_type": "EXACT",
        "anchor_locator": {
          "type": "slide",
          "text_contains": "BẢN THÂN"
        }
      }
    ]
  },
  {
    "criteria_name": "Navigation Buttons",
    "allocated_points": 1.0,
    "anchor_locator": {
      "type": "slide_master"
    },
    "rules": [
      {
        "description": "Verify 3 action buttons (back, home, forward) are present on the Slide Master.",
        "action": "VERIFY_COUNT",
        "points": 1.0,
        "element_type": "shape",
        "is_action_button": true,
        "expected_count": 3
      }
    ]
  },
  {
    "criteria_name": "Table of Contents Hyperlinks",
    "allocated_points": 2.0,
    "anchor_locator": {
      "type": "slide",
      "text_contains": "MỤC LỤC"
    },
    "rules": [
      {
        "description": "Verify 'Thông tin bản thân' text links to 'slide3.xml'.",
        "action": "VERIFY_PROPERTY",
        "points": 0.7,
        "element_type": "text_run",
        "must_contain_text": "Thông tin bản thân",
        "property_to_check": "properties.hyperlink_target",
        "expected_value": "slide3.xml",
        "match_type": "EXACT"
      },
      {
        "description": "Verify 'Quá trình học tập' text links to 'slide4.xml'.",
        "action": "VERIFY_PROPERTY",
        "points": 0.7,
        "element_type": "text_run",
        "must_contain_text": "Quá trình học tập",
        "property_to_check": "properties.hyperlink_target",
        "expected_value": "slide4.xml",
        "match_type": "EXACT"
      },
      {
        "description": "Verify 'Lời cam đoan' text links to 'slide5.xml'.",
        "action": "VERIFY_PROPERTY",
        "points": 0.6,
        "element_type": "text_run",
        "must_contain_text": "Lời cam đoan",
        "property_to_check": "properties.hyperlink_target",
        "expected_value": "slide5.xml",
        "match_type": "EXACT"
      }
    ]
  }
]