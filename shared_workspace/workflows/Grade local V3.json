    {
      "parameters": {
        "jsCode": "const results = [];\n\ntry {\n    // Trỏ trực tiếp đến đường dẫn dữ liệu từ node Webhook của bạn\n    const rawData = $('Webhook').first().json.body.data;\n    \n    if (rawData) {\n        // Parse chuỗi stringified JSON thành Object\n        const parsedData = JSON.parse(rawData);\n        const rubrics = parsedData.rubrics;\n\n        if (rubrics) {\n            // Lặp qua từng loại (word, excel, ppt)\n            for (const [type, filePaths] of Object.entries(rubrics)) {\n                \n                // Lặp qua các đường dẫn trong mảng để trích xuất thông tin\n                filePaths.forEach((sourcePath, index) => {\n                    // Tạo tên file mới tương ứng: word1.json, word2.json, excel1.json...\n                    const newFileName = `${type}${index + 1}.json`;\n                    \n                    // Đẩy từng file thành một item riêng biệt vào danh sách kết quả\n                    results.push({\n                        json: {\n                            type: type,\n                            sourcePath: sourcePath,\n                            newFileName: newFileName\n                        }\n                    });\n                });\n            }\n        }\n    }\n} catch (error) {\n    // Trả về thông báo lỗi nếu chuỗi JSON không hợp lệ hoặc sai cấu trúc\n    results.push({\n        json: {\n            error: \"Lỗi parse hoặc xử lý cấu trúc dữ liệu: \" + error.message\n        }\n    });\n}\n\n// Trả về danh sách các file để truyền sang node Execute Command tiếp theo\nreturn results;"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
