{
  "name": "Grade local",
  "nodes": [
    {
      "parameters": {
        "command": "=python n8n_bridge.py grade_local"
      },
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [
        624,
        464
      ],
      "id": "57e5a489-a8d8-43aa-b7a9-42150f939fda",
      "name": "Execute Command",
      "alwaysOutputData": false
    },
    {
      "parameters": {
        "jsCode": "const rawData = $('Execute Command').first().json.stdout;\nconst pythonOutput = JSON.parse(rawData);\n\nconst studentsMap = {};\n\npythonOutput.forEach(item => {\n\n    const parts = item.file_name.split('.');\n    const ext = parts.pop().toLowerCase();\n    const mssv = parts.join('.'); \n\n    if (!studentsMap[mssv]) {\n        studentsMap[mssv] = {\n            mssv: mssv,\n            word: null,\n            excel: null,\n            pptx: null\n        };\n    }\n\n    if (ext === 'docx' || ext === 'doc') {\n        studentsMap[mssv].word = item;\n    } else if (ext === 'xlsx' || ext === 'xls') {\n        studentsMap[mssv].excel = item;\n    } else if (ext === 'pptx' || ext === 'ppt') {\n        studentsMap[mssv].pptx = item;\n    }\n});\n\nreturn Object.values(studentsMap).map(student => ({ json: student }));"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1696,
        464
      ],
      "id": "f88b5d51-d2ef-49dc-9464-87fe61767077",
      "name": "Code in JavaScript"
