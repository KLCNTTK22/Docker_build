    {
      "parameters": {
        "jsCode": "const fileName = $('Loop Submissions').first().json.name;\nconst studentsList = $('Get students').all().map(item => item.json);\n\nconst matchedStudent = studentsList.find(student => {\n    return fileName.includes(String(student.MSSV));\n});\n\nif (matchedStudent) {\n    return {\n        json: {\n            MSSV: matchedStudent.MSSV,\n            Ho_Ten: matchedStudent[\"Họ tên\"],\n            Email: matchedStudent.Email,\n            SDT: matchedStudent[\"SĐT\"],\n            row_number: matchedStudent.row_number, \n            file_name_goc: fileName,\n            is_matched: true\n        }\n    };\n} else {\n    return {\n        json: {\n            MSSV: \"UNKNOWN\",\n            Ho_Ten: \"Không xác định\",\n            Email: \"\",\n            SDT: \"\",\n            row_number: null,\n            file_name_goc: fileName,\n            is_matched: false\n        }\n    };\n}"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        4720,
        352
      ],
      "id": "ee07769b-b115-44ec-a9fd-e61b9e9cac04",
      "name": "Code in JavaScript"
    },
